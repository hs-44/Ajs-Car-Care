# Copy this file to .env and fill in real values before running in production

PORT=4000

# Used to sign login sessions (JWT). Use a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-string

# Default admin account created automatically on first run (change after login!)
ADMIN_EMAIL=admin@ajscarcare.in
ADMIN_PASSWORD=ChangeMe123!

# Get these from https://dashboard.razorpay.com (Settings > API Keys)
# Use the "Test Mode" keys first, switch to live keys when ready to accept real payments.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
